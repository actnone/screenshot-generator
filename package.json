{
  "name": "screenshot-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.2"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src",
    "generate": "node scripts/generate-screenshots.mjs",
    "generate:all": "yarn generate",
    "generate:app-store": "yarn generate --store appStore",
    "generate:google-play": "yarn generate --store googlePlay",
    "generate:app-store:black-dust": "yarn generate --store appStore --project eldrum-black-dust",
    "generate:app-store:untold": "yarn generate --store appStore --project eldrum-untold",
    "generate:app-store:red-tide": "yarn generate --store appStore --project eldrum-red-tide",
    "generate:google-play:black-dust": "yarn generate --store googlePlay --project eldrum-black-dust",
    "generate:google-play:untold": "yarn generate --store googlePlay --project eldrum-untold",
    "generate:google-play:red-tide": "yarn generate --store googlePlay --project eldrum-red-tide"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "yarn@4.6.0",
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^27",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^27.3.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "sass": "^1.83.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  }
}
